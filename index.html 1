function show(route){
  if(!PAGES.includes(route))route='home';
  document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='p-'+route));
  document.querySelectorAll('.nav-links a').forEach(a=>a.classList.toggle('active',a.dataset.route===route));
  const nav=document.getElementById('nav');nav.classList.remove('open');
  if(route==='home'){nav.classList.remove('solid');nav.classList.toggle('scrolled',scrollY>40);}else{nav.classList.add('solid');}
  window.scrollTo(0,0);
  const page=document.getElementById('p-'+route);
  revealIn(page);runCounters(page);
  if(route==='provinces'&&!mapDone){initMap();mapDone=true;}
  if(route==='home'&&!heroDone){initHero();heroDone=true;}
}

