.event .ev-date .d{font-family:"General Sans";font-weight:600;font-size:2.3rem;line-height:1;color:var(--maroon)}
.event .ev-date .m{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--yellow-deep)}
.event h3{font-size:1.12rem}
.event .ev-meta{font-size:13px;color:var(--ink-soft);display:flex;flex-direction:column;gap:6px;margin-top:auto}
.event .ev-meta .row{display:flex;align-items:center;gap:9px}
.event .ev-meta svg{width:15px;height:15px;color:var(--maroon);flex:0 0 auto}
.event .ev-status{align-self:flex-start;font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:5px 10px;border-radius:6px;font-weight:600}
.st-upcoming{background:var(--maroon-tint);color:var(--maroon)}
.st-past{background:var(--paper-2);color:var(--ink-soft)}

/* gallery */
.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.gallery .photo{aspect-ratio:1/1;border-radius:14px;border:1px solid var(--line)}

/* cta */
.cta{background:linear-gradient(155deg,var(--maroon),var(--maroon-deep));color:#fff;border-radius:26px;padding:58px;position:relative;overflow:hidden}
.cta::before{content:"";position:absolute;inset:0;background:radial-gradient(620px 360px at 88% 16%,rgba(244,180,0,.22),transparent 60%)}
.cta-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:44px;align-items:center}
.cta h2{font-size:clamp(1.8rem,3.2vw,2.5rem)}
.cta p{margin-top:14px;color:rgba(255,255,255,.85);max-width:460px}
.form-card{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:var(--radius);padding:28px;backdrop-filter:blur(8px)}
.form-card label{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.85)}
.field{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.field input{flex:1;min-width:200px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.26);border-radius:100px;padding:14px 20px;color:#fff;font-family:inherit;font-size:14.5px;outline:none;transition:border .3s}
.field input::placeholder{color:rgba(255,255,255,.6)}
.field input:focus{border-color:var(--yellow)}
.form-note{margin-top:12px;font-size:12px;color:rgba(255,255,255,.75)}
.form-ok{margin-top:12px;font-size:13.5px;color:#ffe08a;display:none}
.form-ok.show{display:block}

/* page hero (sub pages) */
.page-hero{padding:150px 0 70px;background:linear-gradient(160deg,var(--maroon),var(--maroon-deep));color:#fff;position:relative;overflow:hidden}
.page-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(700px 420px at 86% 10%,rgba(244,180,0,.2),transparent 60%)}
.page-hero .wrap{position:relative;z-index:2}
.page-hero h1{font-size:clamp(2.2rem,4.4vw,3.4rem);margin-top:14px;max-width:760px}
.page-hero p{margin-top:18px;color:rgba(255,255,255,.84);max-width:600px;font-size:1.08rem}
.crumbs{font-size:12.5px;color:rgba(255,255,255,.7)}
.crumbs a{color:var(--yellow)}

/* footer */
footer{background:var(--ink);color:#fff;padding:66px 0 32px}
.foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.1fr;gap:34px}
.foot-brand .logo-img{height:40px;filter:brightness(0) invert(1)}
.foot-brand p{color:rgba(255,255,255,.6);font-size:14px;margin-top:18px;max-width:300px}
.foot-col h5{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--yellow);margin:0 0 16px;font-family:"General Sans";font-weight:600}
.foot-col a,.foot-col p{display:block;color:rgba(255,255,255,.6);font-size:14px;padding:5px 0;transition:color .25s}
.foot-col a:hover{color:#fff}
.socials{display:flex;gap:10px;margin-top:18px}
.socials a{width:40px;height:40px;border:1px solid rgba(255,255,255,.18);border-radius:11px;display:grid;place-items:center;color:#fff;transition:all .3s}
.socials a:hover{border-color:var(--yellow);color:var(--yellow);transform:translateY(-3px)}
.socials svg{width:18px;height:18px}
.foot-bottom{margin-top:46px;padding-top:24px;border-top:1px solid rgba(255,255,255,.14);display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;color:rgba(255,255,255,.6);font-size:13px}

/* responsive */
@media(max-width:980px){
  .nav-links{display:none}.nav-toggle{display:grid;place-items:center}
