function countUp(el){const t=+el.dataset.count,s=el.dataset.suffix||'',d=1500,t0=performance.now();(function st(n){const p=Math.min((n-t0)/d,1),e=1-Math.pow(1-p,3);el.textContent=Math.round(t*e)+s;if(p<1)requestAnimationFrame(st)})(t0);}
function revealIn(page){if(obs)obs.disconnect();obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target)}}),{threshold:.12});page.querySelectorAll('.reveal').forEach(el=>{el.classList.remove('in');obs.observe(el)});}
