<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>SANTACO — South African National Taxi Council | The Engine Behind the Nation</title>
<meta name="description" content="The South African National Taxi Council (SANTACO) is the unified voice of the minibus taxi industry — championing a transformed, inclusive and sustainable public transport sector across all nine provinces." />
<meta property="og:type" content="website" />
<meta property="og:title" content="SANTACO — The Engine Behind the Nation" />
<meta property="og:image" content="https://santaco.org/wp-content/uploads/2025/04/SA-Taxi.jpg" />
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ===========================================================
   SANTACO — shared stylesheet  (maroon + yellow, white-dominant)
   =========================================================== */
:root{
  --white:#FFFFFF;
  --paper:#FAF7F8;
  --paper-2:#F3EBEE;
  --ink:#211A1E;
  --ink-soft:#6C5A62;
  --maroon:#7B1E2E;
  --maroon-deep:#561120;
  --maroon-tint:#F7E9EC;
  --yellow:#F4B400;
  --yellow-deep:#B98400;
  --yellow-tint:#FFF6DC;
  --line:rgba(33,26,30,.12);
  --line-2:rgba(33,26,30,.06);
  --radius:18px;
  --maxw:1240px;
  --ease:cubic-bezier(.16,.84,.34,1);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:"Inter",system-ui,-apple-system,sans-serif;color:var(--ink);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden}
h1,h2,h3,h4,.display{font-family:"General Sans","Inter",sans-serif;font-weight:600;letter-spacing:-.02em;line-height:1.07;margin:0}
p{margin:0}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;display:inline-flex;align-items:center;gap:10px;color:var(--maroon)}
.eyebrow::before{content:"";width:26px;height:2px;background:var(--yellow)}

/* image w/ graceful fallback */
.photo{position:relative;overflow:hidden;background:linear-gradient(150deg,var(--maroon),var(--ink) 85%)}
.photo>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .5s}
.photo>img.fail{opacity:0}
.photo .flabel{position:absolute;left:14px;bottom:12px;z-index:1;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.72)}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 24px;border-radius:100px;font-weight:600;font-size:14.5px;cursor:pointer;border:1.5px solid transparent;transition:all .35s var(--ease);white-space:nowrap}
.btn svg{width:16px;height:16px}
.btn-maroon{background:var(--maroon);color:#fff}
.btn-maroon:hover{background:var(--maroon-deep);transform:translateY(-2px);box-shadow:0 14px 28px -12px rgba(123,30,46,.55)}
.btn-outline{background:#fff;color:var(--ink);border-color:var(--line)}
.btn-outline:hover{border-color:var(--maroon);color:var(--maroon);transform:translateY(-2px)}
.btn-yellow{background:var(--yellow);color:#3a2a00}
.btn-yellow:hover{background:var(--yellow-deep);color:#fff;transform:translateY(-2px)}

/* nav */
header.nav{position:fixed;top:0;left:0;right:0;z-index:100;transition:all .4s var(--ease)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;gap:22px;padding:15px 28px;max-width:var(--maxw);margin:0 auto}
.nav.scrolled,.nav.solid{background:rgba(255,255,255,.88);backdrop-filter:blur(16px) saturate(150%);-webkit-backdrop-filter:blur(16px) saturate(150%);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px}
.brand .logo-img{height:42px;width:auto}
.brand .logo-fallback{display:none;align-items:center;gap:11px}
.brand .logo-img.fail{display:none}
.brand .logo-img.fail + .logo-fallback{display:flex}
.brand-mark{width:42px;height:42px;border-radius:11px;flex:0 0 auto;background:var(--maroon);display:grid;place-items:center}
.brand-mark svg{width:24px;height:24px}
.brand-txt b{font-family:"General Sans";font-weight:700;font-size:18px;display:block;line-height:1}
.brand-txt span{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}
.nav-links{display:flex;align-items:center;gap:26px}
.nav-links a{color:var(--ink);font-size:14px;font-weight:500;position:relative;padding:6px 0}
.nav-links a.active{color:var(--maroon)}
.nav-links a::after{content:"";position:absolute;left:0;bottom:0;width:0;height:2px;background:var(--yellow);transition:width .3s var(--ease)}
.nav-links a:hover::after,.nav-links a.active::after{width:100%}
.nav-toggle{display:none;background:#fff;border:1px solid var(--line);border-radius:10px;width:44px;height:44px;cursor:pointer}
.nav-toggle svg{width:22px;height:22px;margin:auto;color:var(--ink)}

/* sections */
.band{padding:100px 0}
.band-paper{background:var(--paper)}
.band-paper2{background:var(--paper-2)}
.band-maroon{background:linear-gradient(160deg,var(--maroon),var(--maroon-deep));color:#fff}
.band-ink{background:var(--ink);color:#fff}
.sec-head{max-width:760px;margin-bottom:48px}
.sec-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin-top:16px}
.sec-head p{margin-top:16px;font-size:1.05rem;color:var(--ink-soft)}
.band-maroon .sec-head p{color:rgba(255,255,255,.82)}
.band-maroon .eyebrow,.band-ink .eyebrow{color:#fff}
.band-maroon .eyebrow::before,.band-ink .eyebrow::before{background:var(--yellow)}

.reveal{opacity:0;transform:translateY(26px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.reveal.in{opacity:1;transform:none}
.reveal[data-d="1"]{transition-delay:.07s}.reveal[data-d="2"]{transition-delay:.14s}
.reveal[data-d="3"]{transition-delay:.21s}.reveal[data-d="4"]{transition-delay:.28s}

/* ---- HERO ---- */
.hero{position:relative;min-height:100vh;background:var(--white);display:flex;align-items:center;overflow:hidden}
#bg3d,#net{position:absolute;inset:0;width:100%;height:100%;z-index:0}
#net{opacity:.5}
.hero-bg-accent{position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(820px 520px at 86% 16%,var(--maroon-tint),transparent 62%),radial-gradient(600px 420px at 6% 92%,var(--yellow-tint),transparent 60%)}
.hero-grid{position:relative;z-index:3;width:100%;max-width:var(--maxw);margin:0 auto;padding:128px 28px 150px;display:grid;grid-template-columns:1.04fr .96fr;gap:46px;align-items:center}
.hero-copy{max-width:600px}
.tagline{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--maroon);letter-spacing:.03em;background:var(--maroon-tint);border:1px solid rgba(123,30,46,.2);padding:7px 14px;border-radius:100px;margin-bottom:20px}
.tagline b{color:var(--yellow-deep)}
.hero h1{font-size:clamp(2.5rem,5vw,4.1rem);font-weight:600;margin:6px 0 0;letter-spacing:-.025em}
.hero h1 .g{color:var(--maroon)}
.hero .lead{margin-top:22px;font-size:clamp(1.02rem,1.4vw,1.16rem);color:var(--ink-soft);max-width:520px}
.hero-actions{margin-top:30px;display:flex;gap:13px;flex-wrap:wrap}
.hero-meta{margin-top:38px;display:flex;gap:26px;flex-wrap:wrap}
.hero-meta div{font-size:13px;color:var(--ink-soft)}
.hero-meta b{display:block;font-family:"General Sans";font-weight:600;color:var(--ink);font-size:16px}
.hero-visual{position:relative}
.hero-photo{border-radius:22px;aspect-ratio:4/3.3;box-shadow:0 40px 80px -40px rgba(33,26,30,.5);border:1px solid var(--line)}
.hero-stats{position:absolute;left:-18px;bottom:-26px;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:16px;padding:16px 20px;display:flex;gap:22px;box-shadow:0 26px 50px -28px rgba(33,26,30,.4)}
.hero-stats .hs b{font-family:"General Sans";font-weight:600;font-size:1.5rem;display:block;line-height:1;color:var(--maroon)}
.hero-stats .hs span{font-size:11px;color:var(--ink-soft)}
.hero-badge{position:absolute;top:-14px;right:-10px;background:var(--maroon);color:#fff;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:8px 14px;border-radius:100px;box-shadow:0 12px 24px -10px rgba(123,30,46,.6)}

/* driving taxi */
.road{position:absolute;left:0;right:0;bottom:0;height:130px;z-index:2;pointer-events:none;overflow:hidden}
.road::after{content:"";position:absolute;left:0;right:0;bottom:36px;height:3px;background:repeating-linear-gradient(90deg,var(--line) 0 30px,transparent 30px 60px)}
.road::before{content:"";position:absolute;left:0;right:0;bottom:0;height:46px;background:linear-gradient(transparent,var(--paper))}
.taxi{position:absolute;bottom:22px;left:0;width:330px;will-change:transform;animation:drive 16s linear infinite}
.taxi .wheel-spin{transform-box:fill-box;transform-origin:center;animation:spin 0.85s linear infinite}
.taxi .bob{animation:bob 1.5s ease-in-out infinite}
@keyframes drive{0%{transform:translateX(-360px)}100%{transform:translateX(calc(100vw + 80px))}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.5px)}}
.scroll-cue{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);z-index:4;color:var(--ink-soft);font-size:11px;letter-spacing:.18em;text-transform:uppercase}

/* trust */
.trust{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.trust-inner{display:flex;align-items:center;gap:34px;padding:18px 28px;max-width:var(--maxw);margin:0 auto;flex-wrap:wrap}
.trust-lab{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);white-space:nowrap}
.trust-items{display:flex;gap:24px;flex-wrap:wrap;align-items:center}
.trust-items span{font-family:"General Sans";font-weight:500;font-size:14px;color:var(--ink)}

/* about / president */
.pres{display:grid;grid-template-columns:.82fr 1.18fr;gap:50px;align-items:center}
.pres-portrait{border-radius:var(--radius);aspect-ratio:4/4.7;border:1px solid var(--line);background:var(--maroon-tint);display:grid;place-items:center}
.pres-portrait .mono{font-family:"General Sans";font-weight:600;font-size:4rem;color:var(--maroon)}
.pres-portrait .supply{position:absolute;bottom:14px;left:0;right:0;text-align:center;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--maroon);opacity:.72}
.pres-portrait .pp-tag{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:20px;background:linear-gradient(transparent,rgba(40,10,16,.86));color:#fff}
.pres-portrait .pp-tag b{font-family:"General Sans";font-weight:600;font-size:18px;display:block}
.pres-portrait .pp-tag span{font-size:12.5px;color:rgba(255,255,255,.8)}
.pres-body blockquote{font-family:"General Sans";font-weight:500;font-size:clamp(1.3rem,2.3vw,1.8rem);line-height:1.3;margin:18px 0 0;letter-spacing:-.01em}
.pres-body blockquote .q{color:var(--yellow-deep)}
.vm-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:26px}
.vm{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px}
.vm h4{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--maroon)}
.vm p{margin-top:10px;font-size:14px;color:var(--ink-soft)}
.draft-note{margin-top:16px;font-size:12px;color:var(--ink-soft);font-style:italic}
.sig{margin-top:20px}.sig b{font-family:"General Sans";font-size:1.05rem}.sig span{display:block;font-size:13px;color:var(--ink-soft)}

/* timeline */
.timeline{position:relative;display:grid;grid-template-columns:repeat(7,1fr);gap:0;margin-top:10px}
.timeline::before{content:"";position:absolute;left:0;right:0;top:30px;height:2px;background:var(--line)}
.tl{position:relative;padding:0 12px}
.tl .dot{width:14px;height:14px;border-radius:50%;background:var(--maroon);border:3px solid #fff;box-shadow:0 0 0 2px var(--maroon);position:relative;z-index:2;margin:24px auto 0}
.tl .yr{font-family:"General Sans";font-weight:600;font-size:1.15rem;text-align:center;margin-top:14px;color:var(--maroon)}
.tl p{font-size:12.5px;color:var(--ink-soft);text-align:center;margin-top:6px;line-height:1.4}

/* leadership */
.lead-hero{position:relative;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);margin-bottom:34px;aspect-ratio:21/8}
.lead-hero .cap{position:absolute;left:0;right:0;bottom:0;padding:22px 26px;background:linear-gradient(transparent,rgba(40,10,16,.82));color:#fff;z-index:2}
.lead-hero .cap b{font-family:"General Sans";font-weight:600;font-size:1.2rem;display:block}
.lead-hero .cap span{font-size:13px;color:rgba(255,255,255,.82)}
.leaders{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.leader{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:transform .4s var(--ease),box-shadow .4s}
.leader:hover{transform:translateY(-5px);box-shadow:0 26px 50px -30px rgba(33,26,30,.3)}
.leader .lead-photo{aspect-ratio:1/1;position:relative;background:var(--maroon-tint);display:grid;place-items:center;overflow:hidden}
.leader .lead-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.leader .lead-photo img.fail{display:none}
.leader .monogram{font-family:"General Sans";font-weight:600;font-size:2.4rem;color:var(--maroon)}
.lead-photo .supply{position:absolute;bottom:10px;left:0;right:0;text-align:center;font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--maroon);opacity:.7}
.lead-photo .prov-chip{position:absolute;top:10px;right:10px;background:var(--yellow);color:#3a2a00;font-size:10px;font-weight:600;letter-spacing:.04em;padding:4px 9px;border-radius:6px;z-index:2}
.leader .lead-body{padding:16px 18px 20px}
.leader .lvl{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--yellow-deep);font-weight:600}
.leader h3{font-size:1.1rem;margin-top:7px}
.leaders-note{margin-top:24px;font-size:13px;color:var(--ink-soft)}

/* pillars */
.pillars{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff}
.pillar{padding:26px 22px 30px;border-right:1px solid var(--line);transition:background .4s var(--ease)}
.pillar:last-child{border-right:none}
.pillar:hover{background:var(--maroon-tint)}
.pillar .pic{width:32px;height:32px;color:var(--maroon)}
.pillar .pn{font-size:12px;color:var(--yellow-deep);font-weight:600;margin-top:22px}
.pillar h3{font-size:1.1rem;margin-top:6px}
.pillar p{font-size:13px;color:var(--ink-soft);margin-top:10px;line-height:1.5}

/* impact */
.impact{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.impact-card{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:var(--radius);padding:30px 26px}
.impact-card .ic-num{font-family:"General Sans";font-weight:600;font-size:clamp(2.3rem,4.6vw,3.2rem);letter-spacing:-.03em;line-height:1}
.impact-card .ic-num small{color:var(--yellow);font-size:.5em;vertical-align:super;margin-left:2px}
.impact-card .ic-lab{margin-top:12px;color:rgba(255,255,255,.85);font-size:14px}
.impact-foot{margin-top:30px;font-size:12.5px;color:rgba(255,255,255,.75);max-width:680px}

/* provinces map */
.prov-wrap{display:grid;grid-template-columns:1.25fr .75fr;gap:42px;align-items:center}
.map-stage{position:relative;width:100%;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;padding:18px}
#sa-map{width:100%;height:auto;display:block}
#sa-map path{fill:#EAD9DD;stroke:#fff;stroke-width:2;cursor:pointer;transition:fill .25s}
#sa-map path:hover{fill:var(--maroon)}
#sa-map path.active{fill:var(--maroon)}
#sa-map .lbl{font-family:"General Sans";font-weight:600;font-size:15px;fill:var(--ink);pointer-events:none;text-anchor:middle}
#sa-map .lbl.on{fill:#fff}
.prov-panel{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;min-height:250px;box-shadow:0 20px 40px -30px rgba(33,26,30,.3)}
.prov-panel .pp-prov{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--maroon)}
.prov-panel h3{font-size:1.55rem;margin-top:8px}
.prov-panel .pp-row{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--line-2);font-size:14px}
.prov-panel .pp-row span:first-child{color:var(--ink-soft)}
.prov-panel .pp-row:last-of-type{border-bottom:none}
.prov-hint{font-size:12px;color:var(--ink-soft);margin-top:14px}

/* cards (programmes teaser / initiatives) */
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:transform .45s var(--ease),box-shadow .45s;display:flex;flex-direction:column}
.card:hover{transform:translateY(-6px);box-shadow:0 30px 56px -34px rgba(33,26,30,.34)}
.card .cvis{height:180px;position:relative}
.card .cvis .tag{position:absolute;left:16px;bottom:14px;z-index:2;font-size:11px;letter-spacing:.1em;text-transform:uppercase;background:var(--yellow);color:#3a2a00;padding:6px 11px;border-radius:7px;font-weight:600}
.card .cbody{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1}
.card h3{font-size:1.18rem}
.card p{margin-top:10px;font-size:13.5px;color:var(--ink-soft);line-height:1.55}
.card .more{margin-top:16px;display:inline-flex;align-items:center;gap:8px;color:var(--maroon);font-weight:600;font-size:13.5px}
.card .more svg{width:15px;height:15px;transition:transform .3s}
.card:hover .more svg{transform:translateX(4px)}

/* programme detail */
.prog{display:grid;grid-template-columns:1fr 1fr;gap:46px;align-items:center;padding:50px 0;border-bottom:1px solid var(--line)}
.prog:nth-child(even) .prog-media{order:2}
.prog-media{border-radius:var(--radius);aspect-ratio:4/3;border:1px solid var(--line)}
.prog-body .eyebrow{margin-bottom:14px}
.prog-body h2{font-size:clamp(1.6rem,3vw,2.3rem)}
.prog-body p{margin-top:14px;color:var(--ink-soft);font-size:15px;line-height:1.65}
.prog-facts{display:flex;gap:24px;margin-top:22px;flex-wrap:wrap}
.prog-facts .pf b{font-family:"General Sans";font-weight:600;font-size:1.5rem;color:var(--maroon);display:block}
.prog-facts .pf span{font-size:12.5px;color:var(--ink-soft)}

/* media centre */
.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:34px}
.chip{border:1px solid var(--line);background:#fff;border-radius:100px;padding:9px 18px;font-size:13px;font-weight:500;cursor:pointer;transition:all .3s;color:var(--ink-soft)}
.chip:hover{border-color:var(--maroon);color:var(--maroon)}
.chip.active{background:var(--maroon);color:#fff;border-color:var(--maroon)}
.statements{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.stmt{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;cursor:pointer;transition:transform .4s var(--ease),box-shadow .4s}
.stmt:hover{transform:translateY(-5px);box-shadow:0 26px 50px -30px rgba(33,26,30,.3)}
.stmt .svis{height:150px;position:relative}
.stmt .sbody{padding:20px;display:flex;flex-direction:column;flex:1}
.stmt .scat{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--maroon);font-weight:600}
.stmt h3{font-size:1.08rem;margin-top:9px;line-height:1.3}
.stmt .sdate{font-size:12.5px;color:var(--ink-soft);margin-top:auto;padding-top:14px}
.stmt .sread{font-size:13px;font-weight:600;color:var(--maroon);margin-top:10px;display:inline-flex;gap:6px;align-items:center}

/* modal */
.modal{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(33,18,22,.55);backdrop-filter:blur(4px)}
.modal.open{display:flex}
.modal-card{background:#fff;border-radius:var(--radius);max-width:620px;width:100%;max-height:88vh;overflow:auto;box-shadow:0 40px 80px -30px rgba(0,0,0,.6)}
.modal-card .mvis{height:200px}
.modal-card .mbody{padding:30px}
.modal-card .scat{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--maroon);font-weight:600}
.modal-card h3{font-size:1.5rem;margin-top:10px}
.modal-card .mdate{font-size:13px;color:var(--ink-soft);margin-top:6px}
.modal-card p.mtext{margin-top:16px;color:var(--ink-soft);font-size:15px;line-height:1.65}
.modal-close{float:right;background:var(--paper-2);border:none;width:38px;height:38px;border-radius:10px;cursor:pointer;font-size:18px;color:var(--ink)}

/* events */
.events{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.event{border:1px solid var(--line);border-radius:var(--radius);padding:26px;background:#fff;display:flex;flex-direction:column;gap:12px}
